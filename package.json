{
	"name": "@incutonez/fabled-basin",
	"description": "Fabled Basin Phaser 3 Game",
	"version": "2.2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/incutonez/fabled-basin.git"
	},
	"author": "incutonez@hotmail.com",
	"license": "MIT",
	"licenseUrl": "http://www.opensource.org/licenses/mit-license.php",
	"keywords": [
		"phaser",
		"phaser3",
		"typescript",
		"vue",
		"vite"
	],
	"scripts": {
		"dev": "vite --config vite/config.dev.ts",
		"build": "vite build --config vite/config.prod.ts",
		"explode": "npm cache clean --force && npx rimraf package-lock.json **/node_modules --glob && npm i",
		"prepare": "husky",
		"update:deps": "node ./updateDependencies.js"
	},
	"dependencies": {
		"@incutonez/core-ui": "^3.0.13",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"lodash-es": "^4.18.1",
		"phaser": "^4.2.0",
		"reflect-metadata": "^0.2.2",
		"vue": "^3.5.39",
		"vue-router": "^5.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@incutonez/eslint-plugin": "^2.1.4",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^10.0.1",
		"@stylistic/eslint-plugin-ts": "^4.4.1",
		"@tailwindcss/vite": "^4.3.2",
		"@tsconfig/node20": "^20.1.9",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^26.1.0",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vue/tsconfig": "^0.9.1",
		"conventional-changelog-conventionalcommits": "^10.2.1",
		"eslint": "^10.6.0",
		"eslint-plugin-simple-import-sort": "^13.0.0",
		"eslint-plugin-vue": "^10.9.2",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"semantic-release": "^25.0.5",
		"tailwindcss": "^4.3.2",
		"terser": "^5.48.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.62.1",
		"vite": "^8.1.3",
		"vue-tsc": "^3.3.6"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,jsx,ts,tsx,vue}": [
			"npx eslint --fix"
		]
	},
	"release": {
		"branches": [
			"main"
		],
		"plugins": [
			[
				"@semantic-release/commit-analyzer",
				{
					"preset": "conventionalcommits"
				}
			],
			[
				"@semantic-release/release-notes-generator",
				{
					"preset": "conventionalcommits"
				}
			],
			"@semantic-release/changelog",
			[
				"@semantic-release/npm",
				{
					"npmPublish": false
				}
			],
			"@semantic-release/git",
			"@semantic-release/github"
		]
	}
}
